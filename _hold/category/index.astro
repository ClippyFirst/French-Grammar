---
---
import { getCollection } from 'astro:content';
import { categories, getCategory } from '../../../data/categories.mjs';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.key } }));
}

export const prerender = true;

const { category } = Astro.params;
const cat = getCategory(category);

const topics = (await getCollection('fr'))
  .filter((e) => e.data.category === category)
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({
    title: e.data.title_uk,
    desc: e.data.description_uk,
    href: '/fr/' + category + '/' + e.id + '/',
  }));

const catName = cat ? cat.uk : category;
const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Всі теми', href: '/fr/' },
  { label: catName, href: null },
];

const canonical = '/fr/' + category + '/';
const metaTitle = catName + ' — Французька граматика';
---
<Base>
  <Fragment slot="head">
    <title>{metaTitle}</title>
    <meta name="description" content={cat ? cat.description : metaTitle} />
    <link rel="canonical" href={canonical} />
  </Fragment>
  <Header slot="header" />
  <Footer slot="footer" />

  <div class="container">
    <Breadcrumbs crumbs={crumbs} />
    <h1>{catName}</h1>
    <p class="lead">{cat ? cat.description : ''}</p>

    <ul class="topic-list">
      {topics.map(
        (t) => (
          <li>
            <a href={t.href}>{t.title}</a>
            <span class="topic-desc">{t.desc}</span>
          </li>
        )
      )}
    </ul>
  </div>
</Base>