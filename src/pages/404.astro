---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;
---
<Base>
  <Fragment slot="head">
    <title>Сторінка не знайдена — Французька граматика</title>
    <meta name="robots" content="noindex" />
  </Fragment>
  <Header slot="header" />
  <Footer slot="footer" />

  <div class="not-found">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1>Сторінка не знайдена</h1>
    <p>Такої сторінки немає або адресу змінено.</p>
    <p><a href={import.meta.env.BASE_URL}>Повернутись на головну</a> або <a href={import.meta.env.BASE_URL + 'fr/'}>оберіть тему</a>.</p>
  </div>
</Base>