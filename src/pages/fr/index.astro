---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const x = await getCollection('fr');
---
<Base>
  <Fragment slot="head">
    <title>fr gc {x.length}</title>
  </Fragment>
  <h1>FR HELLO {x.length}</h1>
  <ul>
    {x.map(
      (e) => (
        <li>{e.id}</li>
      )
    )}
  </ul>
</Base>