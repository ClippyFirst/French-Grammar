---
import { getCollection } from 'astro:content';
import { categories } from '../../data/categories.mjs';
import { sectionsFor, catCountsFor } from '../../lib/pages.mjs';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const all = await getCollection('fr');
const sections = sectionsFor(all, categories);
const counts = catCountsFor(all);

const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Всі теми', href: null },
];
---

<Base>
  <Fragment slot="head">
    <title>Всі теми — Французька граматика</title>
    <meta name="description" content="Повний перелік тем з французької граматики для україномовних." />
    <link rel="canonical" href={Astro.url.pathname} />
  </Fragment>
  <Header slot="header" />
  <Footer slot="footer" />
  <article class="prose">
    <Breadcrumbs crumbs={crumbs} />
    <div class="container">
      <header class="article-head">
        <h1>Всі теми</h1>
        <p class="lead">Перегляньте теми за категоріями або скористайтеся пошуком.</p>
      </header>
      {sections.map((s) => {
        const cat = categories.find((c) => c.key === s.id.replace('h-', ''));
        return (
          <section key={s.id} class="category-section">
            <h2>
              <a href={'/fr/' + cat.key + '/'}>{cat.uk}</a>
            </h2>
            <p style="color: var(--ink-soft); font-size: 0.9rem; margin-top: -0.5rem; margin-bottom: 0.75rem;">
              {cat.description}
            </p>
            <ul class="topic-list">
              {s.topics.map((t) => (
                <li>
                  <a href={t.href}>{t.title}</a>
                  <span class="topic-desc">{t.desc}</span>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </article>
</Base>
