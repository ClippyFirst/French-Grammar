---
---
import { getCollection } from 'astro:content';
import { categories } from '../../data/categories.mjs';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const all = (await getCollection('fr')).sort((a, b) => a.data.order - b.data.order);
const grouped = categories
  .map((c) => ({ cat: c, topics: all.filter((e) => e.data.category === c.key) }))
  .filter((g) => g.topics.length > 0);

const crumbs = [{ label: 'Головна', href: '/' }, { label: 'Всі теми', href: null }];
---
<Base>
  <Fragment slot="head">
    <title>Всі теми — Французька граматика</title>
    <meta
      name="description"
      content="Повна структура довідника французької граматики для україномовних: усі категорії і теми."
    />
  </Fragment>
  <Header slot="header" />
  <Footer slot="footer" />

  <div class="container">
    <Breadcrumbs crumbs={crumbs} />
    <h1>Всі теми</h1>
    <p>Довідник структуровано темами. Відкрийте категорію і оберіть питання.</p>
    {
      grouped.map((g) => (
        <section aria-labelledby={`h-${g.cat.key}`}>
          <h2 id={`h-${g.cat.key}`}>{g.cat.uk}</h2>
          <ul class="topic-list">
            {g.topics.map((e) => (
              <li>
                <a href={`/fr/${e.data.category}/${e.id}/`}>{e.data.title_uk}</a>
                <span class="topic-desc">{e.data.description_uk}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>