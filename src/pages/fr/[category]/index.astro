---
import { getCollection } from 'astro:content';
import { categories, getCategory } from '../../../data/categories.mjs';
import { sectionsFor } from '../../../lib/pages.mjs';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TOC from '../../../components/TOC.astro';

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.key },
    props: { categoryKey: category.key },
  }));
}

const { categoryKey } = Astro.props;
const all = await getCollection('fr');
const cat = getCategory(categoryKey);
const sections = sectionsFor(all, categories);
const section = sections.find((s) => s.id === 'h-' + categoryKey);

const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Всі теми', href: '/fr/' },
  ...(cat ? [{ label: cat.uk, href: null }] : []),
];

const tocItems = section
  ? [{ id: 'topics', text: 'Теми' }]
  : [];
---

<Base>
  <Fragment slot="head">
    <title>{cat ? cat.uk : categoryKey} — Французька граматика</title>
    <meta name="description" content={cat ? `${cat.description} — Французька граматика для україномовних.` : ''} />
    <link rel="canonical" href={Astro.url.pathname} />
  </Fragment>
  <Header slot="header" />
  <Footer slot="footer" />
  <article class="prose">
    <Breadcrumbs crumbs={crumbs} />
    <div class="container">
      {cat ? (
        <header class="article-head">
          <h1>{cat.uk}</h1>
          <p class="lead">{cat.description}</p>
        </header>
      ) : (
        <h1>Категорія</h1>
      )}
      {section && section.topics.length ? (
        <ul class="topic-list" id="topics">
          {section.topics.map((t) => (
            <li>
              <a href={t.href}>{t.title}</a>
              <span class="topic-desc">{t.desc}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p>Теми в цій категорії ще додаються.</p>
      )}
    </div>
  </article>
</Base>
