---
---
import { getCollection, render } from 'astro:content';
import { getCategory } from '../../../data/categories.mjs';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TOC from '../../../components/TOC.astro';
import RelatedTopics from '../../../components/RelatedTopics.astro';

export function getStaticPaths() {
  const all = getCollection('fr');
  return all.map((e) => ({ params: { category: e.data.category, slug: e.id } }));
}

export const prerender = true;

const { category, slug } = Astro.params;
const all = await getCollection('fr');
const entry = all.find((e) => e.id === slug && e.data.category === category);

if (!entry) {
  return Astro.redirect('/404');
}

const cat = getCategory(category);
const { Content, headings } = await render(entry);

// Structured-data JSON-LD
const ld = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: entry.data.title_uk,
  description: entry.data.description_uk,
  inLanguage: "uk",
  isAccessibleForFree: true,
};

const tocItems = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ id: h.slug, text: h.text }));

// Resolve related topics
const relatedEntries = entry.data.related
  .map((ref) => {
    const [rcat, rslug] = ref.split('/');
    return all.find((e) => e.id === rslug && e.data.category === rcat);
  })
  .filter(Boolean)
  .map((e) => ({
    title_uk: e.data.title_uk,
    title_fr: e.data.title_fr,
    description_uk: e.data.description_uk,
    href: `/fr/${e.data.category}/${e.id}/`,
  }));

const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Всі теми', href: '/fr/' },
  { label: cat?.uk ?? category, href: `/fr/${category}/` },
  { label: entry.data.title_uk, href: null },
];

const pageTitle = `${entry.data.title_uk} — Французька граматика`;
const canonical = `/fr/${category}/${slug}/`;
---
<Base>
  <Fragment slot="head">
    <title>{pageTitle}</title>
    <meta name="description" content={entry.data.description_uk} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={entry.data.description_uk} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)}>
    </script>
    {
      entry.data.tags && entry.data.tags.length
        ? <meta name="keywords" content={entry.data.tags.join(', ')} />
        : null
    }
  </Fragment>
  <Header slot="header" />
  <Footer slot="footer" />

  <article class="container">
    <Breadcrumbs crumbs={crumbs} />

    <header class="article-head">
      <h1>{entry.data.title_uk}</h1>
      {entry.data.title_fr ? <p class="fr-title">{entry.data.title_fr}</p> : null}
      <p class="lead">{entry.data.description_uk}</p>
    </header>

    <div class="content-grid">
      {entry.data.toc && tocItems.length ? <TOC items={tocItems} /> : <div />}
      <div class="prose">
        <Content />
      </div>
    </div>

    {relatedEntries.length ? <RelatedTopics entries={relatedEntries} /> : null}
  </article>
</Base>