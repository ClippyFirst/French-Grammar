---
---
import { getCollection } from 'astro:content';
import { categories } from '../data/categories.mjs';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const all = await getCollection('fr');
const byCat = new Map();
for (const e of all) {
  const k = e.data.category;
  if (!byCat.has(k)) byCat.set(k, []);
  byCat.get(k)!.push(e);
}
const catCards = categories
  .map((c) => ({ ...c, count: (byCat.get(c.key) ?? []).length }))
  .filter((c) => c.count > 0);

const meta = {
  title: 'Французька граматика — довідник для україномовних',
  description:
    'Структурований, точний довідник французької граматики для носітелей української: артиклі, часи, займенники, способи і багато іншого.',
};
---
<Base>
  <Fragment slot="head">
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
  </Fragment>
  <Header slot="header" />
  <Footer slot="footer" />

  <section class="hero">
    <h1>Французька граматика</h1>
    <p class="lede">
      Точний довідник, що відповідає на питання «коли і як використовується»
      у французькій мові. Без зайвих курсових слів — тільки правило,
      формула, приклади, винятки і типові помилки.
    </p>
    <div class="home-search">
      <label class="sr-only" for="home-search-input">Поиск по граматиці</label>
      <input
        class="home-search-input"
        id="home-search-input"
        type="search"
        placeholder="Поиск: минуле, заперечення, артиклі, y…"
        autocomplete="off"
        data-search-input
      />
    </div>
  </section>

  <div class="container">
    <section aria-labelledby="cat-title">
      <h2 id="cat-title" class="section-title">Категорії</h2>
      <ul class="category-grid">
        {
          catCards.map((c) => (
            <li class="category-card">
              <a href={`/fr/${c.key}/`}>
                <span class="category-name">{c.uk}</span>
                <span class="category-desc">{c.description}</span>
                <span class="category-count">{c.count} тем</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>