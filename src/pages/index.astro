---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { categories } from '../data/categories.mjs';
import { catCountsFor } from '../lib/pages.mjs';

const all = await getCollection('fr');
const catCounts = catCountsFor(all);
---

<Base>
  <Fragment slot="head">
    <title>Французька граматика — довідник для україномовних</title>
    <meta name="description" content="Довідник з французької граматики для україномовних. Пошукова система, чіткі формули, приклади з перекладом, типові помилки." />
    <link rel="canonical" href={Astro.url.pathname} />
  </Fragment>
  <Header slot="header" />
  <Footer slot="footer" />

  <section class="hero" aria-labelledby="home-title">
    <h1 id="home-title">Французька граматика</h1>
    <p class="lede">Довідник для україномовних студентів і вчителів: точні правила, зрозумілі пояснення, французькі приклади та навігація між пов'язаними темами.</p>
    <div class="home-search">
      <button class="home-search-input" data-search-input type="button" aria-label="Пошук граматичних тем">
        <span class="search-placeholder-icon" aria-hidden="true">⌕</span><span>Знайти граматичну тему…</span>
      </button>
    </div>
  </section>

  <div class="container">
    <h2>Категорії граматики</h2>
    <p class="category-description">
      Всього тем: <strong>{all.length}</strong>
    </p>
    <div class="category-grid">
      {categories.map((cat) => {
        const count = catCounts[cat.key] || 0;
        return (
          <div class="category-card">
            <a href={'/fr/' + cat.key + '/'}>
              <span class="category-name">{cat.uk}</span>
              <span class="category-desc">{cat.description}</span>
              <span class="category-count">{count} тем</span>
            </a>
          </div>
        );
      })}
    </div>
  </div>
</Base>
