---
import { getCategory } from '../data/categories.mjs';
import { tocFromHeadings } from '../lib/pages.mjs';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TOC from '../components/TOC.astro';
import RelatedTopics from '../components/RelatedTopics.astro';

const { entry, headings, relatedEntries } = Astro.props;
const data = entry.data;
const cat = getCategory(data.category);

const crumbs = [
  { label: 'Головна', href: '/' },
  { label: 'Всі теми', href: '/fr/' },
  ...(cat ? [{ label: cat.uk, href: '/fr/' + data.category + '/' }] : []),
  { label: data.title_uk, href: null },
];

const tocItems = headings ? tocFromHeadings(headings) : [];
---

<Base>
  <Fragment slot="head">
    <title>{data.title_uk} — Французька граматика</title>
    <meta name="description" content={data.description_uk} />
    <link rel="canonical" href={Astro.url.pathname} />
        <meta property="og:title" content={`${data.title_uk} — Французька граматика`} />
    <meta property="og:description" content={data.description_uk} />
    {data.tags && data.tags.length ? (
      <meta name="keywords" content={data.tags.join(', ')} />
    ) : ''}
  </Fragment>
  <Header slot="header" />
  <Footer slot="footer" />
  <article class="prose">
    <Breadcrumbs crumbs={crumbs} />
    <div class="content-grid">
      {tocItems.length > 0 ? <TOC items={tocItems} /> : null}
      <div>
        <header class="article-head">
          <h1>{data.title_uk}</h1>
          <p class="fr-title">{data.title_fr}</p>
          <p class="lead">{data.description_uk}</p>
        </header>
        <slot />
        {relatedEntries && relatedEntries.length > 0 ? (
          <RelatedTopics entries={relatedEntries} />
        ) : null}
      </div>
    </div>
  </article>
</Base>
