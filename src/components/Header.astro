<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Головна сторінка — Французька граматика">
      <span class="brand-mark" aria-hidden="true">fg</span>
      <span>Французька<span class="brand-accent"> граматика</span></span>
    </a>

    <nav class="main-nav" aria-label="Головна навігація">
      <ul>
        <li><a href="/">Головна</a></li>
        <li><a href="/fr/">Всі теми</a></li>
        <li><a href="/exams/">НМТ / ЄВІ</a></li>
