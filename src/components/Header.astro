---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Главна сторінка — Французька граматика">
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" role="img">
        <text x="3" y="17" font-size="15" fill="currentColor">fg</text>
      </svg>
      <span class="brand-text">Французька<span class="brand-accent">Граматика</span></span>
    </a>

    <nav class="main-nav" aria-label="Головна навигація">
      <ul>
        <li><a href="/">Головна</a></li>
        <li><a href="/fr/">Всі теми</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <button class="search-trigger" type="button" data-pagefind-modal aria-label="Поиск">
        <span class="search-icon" aria-hidden="true">🔍</span>
        <span class="search-label">Поиск</span>
      </button>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Переключити тему">
        <span class="theme-icon" aria-hidden="true">◐</span>
      </button>
    </div>

    <button class="nav-toggle" type="button" aria-label="Відкрити меню" data-nav-toggle>
      <span aria-hidden="true">≡</span>
    </button>
  </div>

  <div class="nav-menu" hidden data-nav-menu>
    <ul>
      <li><a href="/">Головна</a></li>
      <li><a href="/fr/">Всі теми</a></li>
    </ul>
  </div>
</header>