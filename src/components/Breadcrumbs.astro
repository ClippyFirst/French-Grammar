---
const { crumbs } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Навігація за ієрархією">
  <ol>
    {(crumbs ?? []).map((c, i) => (
      <li class="crumb" data-i={i}>
        {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>